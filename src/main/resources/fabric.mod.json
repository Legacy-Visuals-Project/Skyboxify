{
	"schemaVersion": 1,
	"id": "optiboxes",
	"version": "${version}",
	"name": "Optiboxes",
	"description": "A skybox mod that allows you to use Optifine skies in Fabric 1.21+",
	"authors": [
		"lowercasebtw",
		"FlashyReese",
		"AMereBagatelle"
	],
	"icon": "assets/optiboxes/icon.png",
	"license": "GPL-3.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"btw.lowercase.optiboxes.OptiBoxesClient"
		],
		"modmenu": [
			"btw.lowercase.optiboxes.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"optiboxes.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.5",
		"minecraft": "~1.21.6",
		"fabric-api": "*"
	}
}
