{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"lowercasebtw",
		"FlashyReese",
		"AMereBagatelle"
	],
	"icon": "assets/${id}/icon.png",
	"license": "${license}",
	"environment": "client",
	"mixins": ["${id}.mixins.json"],
	"entrypoints": {
		"client": ["btw.lowercase.skyboxify.SkyboxifyClient"],
		"modmenu": ["btw.lowercase.skyboxify.config.ModMenuIntegration"]
	},
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${minecraft_version_range}",
		"fabric": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "${discord}",
				"modmenu.modrinth": "${modrinth}",
				"modmenu.curseforge": "${curseforge}"
			},
			"update_checker": true
		}
	}
}
